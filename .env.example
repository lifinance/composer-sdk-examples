# Compose backend the examples compile against.
# Defaults to https://composer.li.quest when unset. Leave this unset to let the
# runner auto-select the right backend per example: production examples use the
# default above, while staged examples use the ETHGlobal preview backend
# (https://ethglobal-composer.li.quest). Setting it here pins ALL examples to
# this URL and disables that auto-selection.
# COMPOSER_BASE_URL=https://composer.li.quest

# Required to access composer
LIFI_API_KEY=
