{
  "name": "composer-sdk-examples",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable examples for @lifi/composer-sdk",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "example": "tsx examples/run.ts",
    "example:staged": "tsx examples/run.ts --staged",
    "start": "tsx examples/run.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:staged": "tsc -p tsconfig.staged.json",
    "test": "tsx verify/contract.ts",
    "staged:install": "npm install --no-save --no-package-lock @lifi/composer-sdk@staging @lifi/compose-spec@staging"
  },
  "dependencies": {
    "@lifi/compose-spec": "0.13.0",
    "@lifi/composer-sdk": "0.13.0",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "json-colorizer": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
